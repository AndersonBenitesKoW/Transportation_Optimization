# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.

# --- IA Generativa (OpenRouter) ---
OPENROUTER_API_KEY=tu_api_key_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Firebase ---
# Ademas del .env necesitas el archivo backend/firebase_credentials.json
# descargado desde Firebase Console > Configuracion del proyecto > Cuentas de servicio.
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
